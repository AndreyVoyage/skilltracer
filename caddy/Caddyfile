# =============================================================================
# Caddy Configuration for Skill Tracer (Native VPS)
# =============================================================================
# - Reverse proxy на backend (localhost:8000)
# - Автоматический HTTPS через Let's Encrypt
# - Сжатие gzip
# - Заголовки безопасности
# - Access logs отключены для экономии диска Host-0
#
# Install:
#   sudo cp caddy/Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
# =============================================================================

{$DOMAIN:localhost} {
    # Проксирование на backend (native, без Docker)
    reverse_proxy localhost:8000
    
    # Сжатие ответов
    encode gzip
    
    # Access logs ОТКЛЮЧЕНЫ для Host-0 (ограниченный диск 13GB)
    # При необходимости раскомментируйте строки ниже:
    # log {
    #     output file /var/log/caddy/access.log {
    #         roll_size 10MB
    #         roll_keep 3
    #         roll_keep_for 720h
    #     }
    # }
    
    # Заголовки безопасности
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
    
    # Health endpoint можно закэшировать коротко (опционально)
    handle /health {
        reverse_proxy localhost:8000
        header Cache-Control "no-cache, no-store, must-revalidate"
    }
}
