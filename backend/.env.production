# =============================================================================
# Skill Tracer - Production Environment for reg.ru Host-0
# =============================================================================
# 
# CRITICAL: Keep this file secret! Do not commit to git!
# Copy this file to .env and fill in your actual values.
#
# reg.ru Host-0 Specifications:
# - CPU: 1 core (3456 CP for MySQL)
# - RAM: 2 GB (use max 2 uvicorn workers)
# - Disk: 13 GB SSD (logs rotate, no file storage)
# - Processes: max 36 (check with ulimit -u)
#
# =============================================================================

# -----------------------------------------------------------------------------
# Telegram Bot Configuration
# Get from @BotFather: https://t.me/botfather
# -----------------------------------------------------------------------------
BOT_TOKEN=your_bot_token_here

# -----------------------------------------------------------------------------
# WebApp URL
# Your reg.ru domain (with HTTPS after SSL setup)
# -----------------------------------------------------------------------------
WEBAPP_URL=https://u1893136.isp.regruhosting.ru

# -----------------------------------------------------------------------------
# Database Configuration (MySQL on reg.ru)
# Create via ISPmanager: Databases → Create
# -----------------------------------------------------------------------------
# Format: mysql+aiomysql://user:password@host/database
DATABASE_URL=mysql+aiomysql://u1893136_skilluser:your_secure_password@localhost/u1893136_skilltracer

# Individual MySQL settings (for docker-compose.yml if needed)
MYSQL_ROOT_PASSWORD=root_password_not_used_in_production
MYSQL_USER=u1893136_skilluser
MYSQL_PASSWORD=your_secure_password
MYSQL_DATABASE=u1893136_skilltracer

# -----------------------------------------------------------------------------
# Security Settings
# Generate with: openssl rand -hex 32
# Minimum 32 characters!
# -----------------------------------------------------------------------------
SECRET_KEY=your-secret-key-change-this-to-random-32-chars

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
ENVIRONMENT=production
DOMAIN=u1893136.isp.regruhosting.ru

# -----------------------------------------------------------------------------
# Performance (reg.ru Host-0 limits)
# -----------------------------------------------------------------------------
# Number of uvicorn workers (2 max for 2GB RAM)
UVICORN_WORKERS=2

# Database pool size (keep low for shared hosting)
DB_POOL_SIZE=5

# Log level
LOG_LEVEL=INFO
