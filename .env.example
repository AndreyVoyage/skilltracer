# =============================================================================
# Skill Tracer Environment Configuration
# Скопируйте этот файл в .env и заполните реальными значениями
# =============================================================================

# -----------------------------------------------------------------------------
# Telegram Bot Configuration
# Получить токен у @BotFather в Telegram
# -----------------------------------------------------------------------------
BOT_TOKEN=your_bot_token_here

# -----------------------------------------------------------------------------
# WebApp URL (для Telegram Mini App)
# В development: http://localhost
# В production: https://your-domain.ru
# -----------------------------------------------------------------------------
WEBAPP_URL=https://your-domain.ru

# -----------------------------------------------------------------------------
# Domain Configuration (для Caddy и webhook)
# localhost - для локальной разработки (без HTTPS)
# your-domain.ru - для продакшена (автоматический HTTPS)
# -----------------------------------------------------------------------------
DOMAIN=your-domain.ru

# -----------------------------------------------------------------------------
# Database Configuration (Native MySQL on localhost)
# Для native VPS установки: mysql на localhost:3306
# -----------------------------------------------------------------------------
DATABASE_URL=mysql+aiomysql://skilluser:skillpass@localhost:3306/skilltracer

# Индивидуальные настройки MySQL (используются в scripts/setup_mysql.sh)
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=skilltracer
MYSQL_USER=skilluser
MYSQL_PASSWORD=skillpass

# -----------------------------------------------------------------------------
# Security
# Секретный ключ для подписей JWT и т.д.
# В production обязательно сгенерировать случайный ключ!
# Генерация: openssl rand -hex 32
# -----------------------------------------------------------------------------
SECRET_KEY=your-secret-key-here-change-in-production

# -----------------------------------------------------------------------------
# Environment
# development - для локальной разработки
# production - для продакшена
# -----------------------------------------------------------------------------
ENVIRONMENT=production

# -----------------------------------------------------------------------------
# Performance (reg.ru Host-0 limits)
# -----------------------------------------------------------------------------
# Number of uvicorn workers (1 max for 1GB RAM native setup)
UVICORN_WORKERS=1

# Database pool size (keep low for shared hosting)
DB_POOL_SIZE=5

# Log level
LOG_LEVEL=INFO
