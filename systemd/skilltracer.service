# =============================================================================
# Systemd Service for Skill Tracer (Native VPS, No Docker)
# =============================================================================
# Оптимизировано для Host-0: 1GB RAM, 1 CPU core
# - 1 uvicorn worker (workers=1)
# - MemoryMax=400M (ограничение RAM через systemd)
# - Bind to 127.0.0.1:8000 (Caddy reverse proxy)
#
# Install:
#   sudo cp systemd/skilltracer.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable skilltracer
#   sudo systemctl start skilltracer
#
# Logs:
#   sudo journalctl -u skilltracer -f
# =============================================================================

[Unit]
Description=Skill Tracer FastAPI Application
Documentation=https://github.com/AndreyVoyage/skilltracer
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=skilltracer
Group=skilltracer
WorkingDirectory=/opt/skilltracer/backend

# Environment
Environment=PATH=/opt/skilltracer/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=/opt/skilltracer/backend
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

# Load .env
EnvironmentFile=/opt/skilltracer/backend/.env

# Uvicorn with 1 worker (critical for 1GB RAM)
ExecStart=/opt/skilltracer/venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 1 \
    --loop uvloop \
    --http h11 \
    --proxy-headers \
    --forwarded-allow-ips '*' \
    --no-access-log

Restart=always
RestartSec=5
StartLimitInterval=60s
StartLimitBurst=3

# Graceful shutdown
TimeoutStopSec=30
KillSignal=SIGTERM

# Resource limits for Host-0 (1GB RAM total)
MemoryMax=400M
MemorySwapMax=100M
TasksMax=50

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/skilltracer/backend/logs /var/log/skilltracer

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=skilltracer

[Install]
WantedBy=multi-user.target
