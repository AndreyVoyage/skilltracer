# =============================================================================
# Systemd Service for Skill Tracer Bot (Polling Mode)
# =============================================================================
# Опциональный отдельный сервис для бота в режиме polling.
# Используется если НЕ используется webhook через FastAPI.
#
# Обычно бот работает внутри FastAPI (app.main), поэтому этот сервис
# нужен только если вы хотите разделить бота и API.
#
# Install:
#   sudo cp systemd/skilltracer-bot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable skilltracer-bot
#   sudo systemctl start skilltracer-bot
# =============================================================================

[Unit]
Description=Skill Tracer Telegram Bot (Polling)
Documentation=https://github.com/AndreyVoyage/skilltracer
After=network.target

[Service]
Type=simple
User=skilltracer
Group=skilltracer
WorkingDirectory=/opt/skilltracer/backend

Environment=PATH=/opt/skilltracer/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=/opt/skilltracer/backend
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/skilltracer/backend/.env

# Запуск polling через Python модуль
ExecStart=/opt/skilltracer/venv/bin/python -m app.bot

Restart=always
RestartSec=10
StartLimitInterval=60s
StartLimitBurst=3

# Resource limits
MemoryMax=200M
TasksMax=30

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/skilltracer/backend/logs /var/log/skilltracer

StandardOutput=journal
StandardError=journal
SyslogIdentifier=skilltracer-bot

[Install]
WantedBy=multi-user.target
